# Copy this file to .env and fill only the services used by your example.

# Optional Redis source
MCPSTORE_DEMO_REDIS_HOST=
MCPSTORE_DEMO_REDIS_PORT=6379
MCPSTORE_DEMO_REDIS_PASSWORD=
MCPSTORE_DEMO_REDIS_DB=0
MCPSTORE_DEMO_REDIS_NAMESPACE=mcpstore_demo

# Optional MCP HTTP service used by workflow examples
MCPSTORE_DEMO_SERVICE_URL=https://example.com/mcp

# Optional LLM provider used by Studio/LangChain examples: qwen, deepseek, or glm
MCPSTORE_DEMO_LLM_PROVIDER=
MCPSTORE_DEMO_QWEN_API_KEY=
MCPSTORE_DEMO_QWEN_API_BASE=
MCPSTORE_DEMO_QWEN_MODEL=
MCPSTORE_DEMO_DEEPSEEK_API_KEY=
MCPSTORE_DEMO_DEEPSEEK_API_BASE=https://api.deepseek.com
MCPSTORE_DEMO_DEEPSEEK_MODEL=deepseek-chat
MCPSTORE_DEMO_GLM_API_KEY=
MCPSTORE_DEMO_GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
MCPSTORE_DEMO_GLM_MODEL=
