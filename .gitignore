# Local policy: ignore everything unless explicitly allowlisted below.
*

# Keep this policy file local; do not commit it.
.gitignore

# Repository metadata/workflows.
!.github/
!.github/**

# Source directories allowlisted for Git.
!Cargo.toml
!Cargo.lock
!src/
!src/**
!satellite/
!satellite/**
!plugins/
!plugins/**
!scripts/
!scripts/**

# Root files allowlisted for Git.
!/LICENSE
!/README.md
!/README_*.md
!/install.sh
!/paseo.json

# README documentation assets (screenshots).
!docs/
!docs/assets/
!docs/assets/images/
!docs/assets/images/*.png

# Markdown is documentation-only unless it is a README.
!README.md
!README_*.md
!**/README.md
!**/README_*.md

# Common local/build output (kept explicit for readability).
.DS_Store
__pycache__/
*.py[cod]
*.so
*.dylib
*.dll
*.pyd
target/
dist/
satellite/web/node_modules
satellite/python/.venv
satellite/web/dist/
# Vite cache belongs in repo-root local/ (ignored by `*`); never under satellite/
satellite/local/
docs/.venv/
docs/site/
release-assets/
# assembled platform binaries; the entry package's wrapper is source and stays tracked
satellite/npm/packages/*/bin/
!satellite/npm/packages/mcpstore/bin/
*.tgz
.obsidian/
.specstory/
.vscode/

# Local example fixtures are intentionally not Git-managed for now.
satellite/python/example_local/
satellite/web/REFACTOR_PLAN.md

# tauri externalBin sidecar, built by run_debug.sh / release workflow
satellite/desktop/tauri/binaries/
LESSONS.md
AGENTS.md
CLAUDE.md
