# Local policy: ignore everything unless explicitly allowlisted below.
*

# Keep this policy file local; do not commit it.
.gitignore

# Repository metadata/workflows.
!.github/
!.github/**

# Source directories allowlisted for Git.
!desktop/
!desktop/**
!i18n/
!i18n/**
!npm/
!npm/**
!plugins/
!plugins/**
!python/
!python/**
!rust/
!rust/**
!scripts/
!scripts/**

# web/: source + config only (not tmp dumps / build output / node_modules).
!web/
!web/biome.json
!web/components.json
!web/index.html
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/tsconfig.app.json
!web/tsconfig.node.json
!web/vite.config.ts
!web/public/
!web/public/**
!web/scripts/
!web/scripts/**
!web/src/
!web/src/**

# Root files allowlisted for Git.
!/LICENSE
!/README.md
!/README_*.md
!/install.sh
!/platforms.toml
!/paseo.json

# README documentation assets (screenshots).
!docs/
!docs/assets/
!docs/assets/images/
!docs/assets/images/*.png

# Markdown is documentation-only unless it is a README.
!README.md
!README_*.md
!**/README.md
!**/README_*.md

# Common local/build output (kept explicit for readability).
.DS_Store
__pycache__/
*.py[cod]
*.so
*.dylib
*.dll
*.pyd
target/
dist/
python/.venv
docs/.venv/
docs/site/
release-assets/
# assembled platform binaries; the entry package's wrapper is source and stays tracked
npm/packages/*/bin/
!npm/packages/mcpstore/bin/
*.tgz
.obsidian/
.specstory/
.vscode/

# Local example fixtures are intentionally not Git-managed for now.
/python/example_local/

# tauri externalBin sidecar, built by run_debug.sh / release workflow
desktop/tauri/binaries/
