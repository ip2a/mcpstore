{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote",
  "description": "Permissions for the web UI served by the local mcpstore daemon Web face.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:**", "http://localhost:**"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "opener:default"
  ]
}
